---
import type { ImageAttribution, PermissionCredit, Locale } from '../contracts/catalog';
import { t } from '../i18n/ui';

// The visible credit an open-licence image carries wherever it is shown (inactive until such a grant exists).
interface Props { credit: ImageAttribution | PermissionCredit; locale: Locale; card?: boolean }
const { credit, locale, card = false } = Astro.props;
const s = t(locale);
const Tag = card ? 'p' : 'span';
// A change without a reviewed translation keeps its English text, marked as English.
// A written permission's required credit (gap G3) is its own verbatim text, with no licence link.
const permission = 'text' in credit ? credit : undefined;
const open_ = 'creator' in credit ? credit : undefined;
const changes = open_?.changes ? s.variants.credit.changed[open_.changes] : undefined;
// A supplied title is the author's own and is never translated; only its quotation marks follow the locale, and it
// is joined to the creator without a new translated word ("«Title» — Creator").
const [open, close] = s.variants.credit.quote;
---
{permission ? <Tag class:list={['gallery-credit', { 'gallery-credit--card': card }]}>{s.variants.credit.photo}: <bdi>{permission.text}</bdi>{permission.url && <> · <a href={permission.url} rel="nofollow">{s.variants.credit.source}</a></>}</Tag> : open_ && <Tag class:list={['gallery-credit', { 'gallery-credit--card': card }]}>
  {s.variants.credit.photo}: {open_.title && <>{open}<bdi>{open_.title}</bdi>{close} — </>}<bdi>{open_.creator}</bdi> · <a href={open_.licenseUrl} rel="license nofollow"><bdi>{open_.license}</bdi></a> · <a href={open_.sourceUrl} rel="nofollow">{s.variants.credit.source}</a>{open_.changes && <> · {s.variants.credit.changes}: {changes ? <bdi>{changes}</bdi> : <bdi lang="en" dir="ltr">{open_.changes}</bdi>}</>}
</Tag>}
