---
import type { Locale } from '../contracts/catalog';
import { href, otherLocale, t } from '../i18n/ui';
import WhatsAppContact from './WhatsAppContact.astro';

interface Props { locale: Locale; path: string }
const { locale, path } = Astro.props;
const s = t(locale);
const other = otherLocale(locale);
const links = [
  { path: '/brands/', label: s.nav.brands },
  { path: '/categories/', label: s.nav.categories },
  { path: '/catalog/', label: s.nav.catalog },
  { path: '/about/', label: s.nav.about },
];
const current = (p: string) => (path.startsWith(p) ? 'page' : undefined);
---
<header class="site-header">
  <div class="wrap site-header__bar">
    <div>
      <nav class="nav-desktop" aria-label={s.menu}>
        {links.map((l) => <a href={href(locale, l.path)} aria-current={current(l.path)}>{l.label}</a>)}
      </nav>
      <details class="menu">
        <summary class="icon-btn" aria-label={s.menu}>
          <svg class="i-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" /></svg>
          <svg class="i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
        </summary>
        <nav class="menu__panel" aria-label={s.menu}>
          {links.map((l) => <a href={href(locale, l.path)} aria-current={current(l.path)}>{l.label}</a>)}
          <div class="menu__meta">
            <a href={href(other, path)} hreflang={other} lang={other}>{t(other).langName}</a>
            <WhatsAppContact locale={locale} variant="menu" />
          </div>
        </nav>
      </details>
    </div>
    <a class="wordmark" href={href(locale)} aria-label="Jwleria">JWLERIA</a>
    <div class="header-actions">
      <a class="icon-btn" href={href(locale, '/catalog/')} aria-label={s.search}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4.2-4.2" /></svg>
      </a>
      <a class="lang" href={href(other, path)} hreflang={other} lang={other}>{t(other).langName}</a>
      <WhatsAppContact locale={locale} variant="icon" class="header-contact" />
    </div>
  </div>
</header>
