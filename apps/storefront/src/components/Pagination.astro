---
import type { Locale, ProductPage } from '../contracts/catalog';
interface Props { locale: Locale; result: ProductPage; url: URL }
const { locale, result, url } = Astro.props;
const link = (page: number) => {
  const next = new URL(url); next.searchParams.set('page', String(page));
  return `${next.pathname}${next.search}`;
};
---
{result.pages > 1 && <nav class="pagination" aria-label={locale === 'ar' ? 'صفحات المنتجات' : 'Product pages'}>
  {result.page > 1 && <a class="btn" rel="prev" href={link(result.page - 1)}>{locale === 'ar' ? 'السابق' : 'Previous'}</a>}
  <span>{locale === 'ar' ? `الصفحة ${result.page} من ${result.pages}` : `Page ${result.page} of ${result.pages}`}</span>
  {result.page < result.pages && <a class="btn" rel="next" href={link(result.page + 1)}>{locale === 'ar' ? 'التالي' : 'Next'}</a>}
</nav>}
