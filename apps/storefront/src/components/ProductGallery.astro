---
import type { Locale, PublicProduct, RepresentativeImage } from '../contracts/catalog';
import { t } from '../i18n/ui';
import { artClass } from './view';
import { productMedia } from './product-media.mjs';
import ImageCredit from './ImageCredit.astro';
import VariantText from './VariantText.astro';

// This variant's own approved images, bounded. A variant without one shows its model's representative photograph
// only when one exists, captioned with that photograph's own reference and size and never as this variant's.
const LIMIT = 8;
interface Props { product: PublicProduct; locale: Locale; representative?: RepresentativeImage }
const { product, locale, representative } = Astro.props;
const s = t(locale);
const shown = product.images.length ? undefined : representative;
const media = shown ? { ...product, images: shown.images, image: shown.images[0], imageVariants: shown.imageVariants } : product;
const views = media.images.slice(0, LIMIT).map((src, i) => ({ src, i, label: s.product.views[i] ?? s.product.details, credit: media.imageVariants?.[i]?.attribution }));
const caption = s.product.representative;
---
{views.length > 0 && <div class="pdp__gallery" aria-label={product.name[locale]} data-gallery={shown ? shown.reference : product.reference}>
  {views.map((v) => (
    <figure>
      <div class="media">
        <img class={v.i === 0 ? artClass(v.src, product.categorySlug, shown?.reference ?? product.reference) : 'art'} {...productMedia(media, v.i, 'detail')} alt={shown ? `${product.name[locale]} — ${shown.reference}` : product.name[locale]} loading={v.i === 0 ? 'eager' : 'lazy'} fetchpriority={v.i === 0 ? 'high' : undefined} decoding="async" />
        {product.isPreview && v.i === 0 && <span class="badge">{s.preview}</span>}
      </div>
      <figcaption>
        {shown
          ? <span class="representative-note">{caption.before}<bdi dir="ltr">{shown.reference}</bdi>{shown.sizeOption && <> (<VariantText text={shown.sizeOption.value[locale]} lang={shown.sizeOption.valueLang} />)</>}{caption.middle}<bdi dir="ltr">{product.reference}</bdi>{caption.end}</span>
          : v.label}
        {v.credit && <ImageCredit credit={v.credit} locale={locale} />}
      </figcaption>
    </figure>
  ))}
</div>}
