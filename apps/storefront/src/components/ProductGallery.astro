---
import type { Locale, PublicProduct, RepresentativeImage, VariantLink } from '../contracts/catalog';
import { t } from '../i18n/ui';
import { artClass } from './view';
import { fullSizeImage, productMedia } from './product-media.mjs';
import { galleryView } from './gallery-view.mjs';
import ImageCredit from './ImageCredit.astro';
import VariantText from './VariantText.astro';

// The selected variant's own approved images, bounded (decision 0019):
// - One image is a plain figure, never a scroll container, so a vertical swipe on it always scrolls the page.
// - Several images are a horizontal-only carousel.
// A variant without its own photograph says so first. Its model's representative photograph (decision 0017)
// follows, small and apart, named by its own reference, size and dial or colour, and never shown as this variant.
const LIMIT = 8;
interface Props { product: PublicProduct; locale: Locale; representative?: RepresentativeImage; variants?: VariantLink[] }
const { product, locale, representative, variants = [] } = Astro.props;
const s = t(locale);
const view = galleryView(product, representative, variants);
// Decision 0027: an exact official original without a canvas (no white square, no flat tile) is shown whole in a frame of
// its own proportions, as large as the screen allows, instead of the short frame sized for square tiles. Its stored width
// and height go to CSS as two plain numbers (--w, --h), never as a ratio inside one property.
const sceneRatio = (i: number) => {
  const m = product.imageVariants?.[i];
  return m && !m.canvas && m.width > 0 && m.height > 0 ? `--w: ${m.width}; --h: ${m.height}` : undefined;
};
const views = view.mode === 'own' ? product.images.slice(0, LIMIT).map((src, i) => ({ src, i, label: s.product.views[i] ?? s.product.details, credit: product.imageVariants?.[i]?.attribution ?? product.imageVariants?.[i]?.permissionCredit, full: fullSizeImage(product, i), white: product.imageVariants?.[i]?.canvas === 'white_square', clipped: product.imageVariants?.[i]?.sourceClipped === true, flat: product.imageVariants?.[i]?.canvas === 'flat_tile', scene: sceneRatio(i) })) : [];
const many = views.length > 1;
const rep = view.mode === 'missing' ? view.representative : undefined;
const details = view.mode === 'missing' ? view.details : [];
const repMedia = rep && { ...product, images: rep.images, image: rep.images[0], imageVariants: rep.imageVariants };
const caption = s.product.representative;
const repFull = repMedia && fullSizeImage(repMedia, 0);
---
{/* Decision 0028: the approved order is kept (the standalone product first). Two or more photographs form a native
    scroll-snap row with dots, count, previous/next and pause/play, enabled by the page script; without JavaScript the
    row still swipes. One photograph renders exactly as before. */}
{views.length > 0 && <div class:list={['pdp__gallery', { 'pdp__gallery--many': many }]} aria-label={product.name[locale]} data-gallery={product.reference}
  {...(many ? { 'data-carousel': '', 'aria-roledescription': s.product.gallery.role } : {})}>
  <div class="carousel__track" data-carousel-track>
  {views.map((v) => (
    <figure>
      <div class:list={['media', { 'media--white': v.white, 'media--flat': v.flat, 'media--scene': Boolean(v.scene) }]} style={v.scene}>
        <img class={v.i === 0 ? artClass(v.src, product.categorySlug, product.reference) : 'art'} {...productMedia(product, v.i, many ? 'detail' : 'single')} alt={product.name[locale]} loading={v.i === 0 ? 'eager' : 'lazy'} fetchpriority={v.i === 0 ? 'high' : undefined} decoding="async" />
        {product.isPreview && v.i === 0 && <span class="badge">{s.preview}</span>}
      </div>
      <figcaption>{v.label}{v.clipped && <> · <span class="source-clipped">{s.product.sourceClipped}</span></>}{v.full && <> · <a class="full-size" href={v.full.src}>{s.product.fullSize(v.full.width, v.full.height)}</a></>}{v.credit && <ImageCredit credit={v.credit} locale={locale} />}</figcaption>
    </figure>
  ))}
  </div>
  {many && <div class="carousel__controls" data-carousel-controls hidden
    data-count={s.product.gallery.count('{n}', '{m}')} data-play={s.product.gallery.play} data-pause={s.product.gallery.pause}>
    <button type="button" class="carousel__btn carousel__btn--prev" data-carousel-prev aria-label={s.product.gallery.prev}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <span class="carousel__dots">
      {views.map((v) => <button type="button" class="carousel__dot" data-carousel-dot aria-label={s.product.gallery.go(v.i + 1, views.length)} aria-current={v.i === 0 ? 'true' : undefined}></button>)}
    </span>
    <span class="carousel__count" data-carousel-count aria-live="off">{s.product.gallery.count(1, views.length)}</span>
    <button type="button" class="carousel__btn carousel__btn--next" data-carousel-next aria-label={s.product.gallery.next}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
    </button>
    <button type="button" class="carousel__btn carousel__btn--toggle" data-carousel-toggle aria-pressed="false" aria-label={s.product.gallery.pause}>
      <svg class="carousel__pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="7" y="5" width="3.2" height="14" /><rect x="13.8" y="5" width="3.2" height="14" /></svg>
      <svg class="carousel__play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5l11 7-11 7z" /></svg>
    </button>
  </div>}
  <p class="pdp__gallery-status" data-gallery-status hidden></p>
</div>}
{rep && repMedia && <div class="pdp__gallery pdp__gallery--missing" aria-label={product.name[locale]} data-gallery={rep.reference}>
  <div class="photo-missing">
    <p class="photo-missing__title">{s.product.noPhoto}</p>
    <p class="photo-missing__ref"><bdi dir="ltr">{product.reference}</bdi></p>
  </div>
  <figure class="pdp__other">
    <div class:list={['media', { 'media--white': rep.imageVariants?.[0]?.canvas === 'white_square', 'media--flat': rep.imageVariants?.[0]?.canvas === 'flat_tile' }]}><img class="art" {...productMedia(repMedia, 0, 'thumb')} alt={`${product.name[locale]} — ${rep.reference}`} decoding="async" /></div>
    <figcaption>
      <span class="representative-note">{caption.before}<bdi dir="ltr">{rep.reference}</bdi>{details.length > 0 && <> ({details.map((o, i) => <>{i > 0 && ' · '}<VariantText text={o.value[locale]} lang={o.valueLang} /></>)})</>}{caption.middle}<bdi dir="ltr">{product.reference}</bdi>{caption.end}</span>
      {rep.imageVariants?.[0]?.sourceClipped && <span class="source-clipped">{s.product.sourceClipped}</span>}
      {repFull && <a class="full-size" href={repFull.src}>{s.product.fullSize(repFull.width, repFull.height)}</a>}
      {(rep.imageVariants?.[0]?.attribution ?? rep.imageVariants?.[0]?.permissionCredit) && <ImageCredit credit={(rep.imageVariants[0].attribution ?? rep.imageVariants[0].permissionCredit)!} locale={locale} />}
    </figcaption>
  </figure>
  <p class="pdp__gallery-status" data-gallery-status hidden></p>
</div>}
