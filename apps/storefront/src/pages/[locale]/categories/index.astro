---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCategories } from '../../../server/catalog';
import { href, isLocale, t } from '../../../i18n/ui';
import { artClass } from '../../../components/view';

const { locale } = Astro.params;
if (!isLocale(locale)) throw new Error('Unknown locale');
const s = t(locale);
---
<BaseLayout locale={locale} title={s.categories.title} description={s.categories.lead} path="/categories/">
  <div class="wrap">
    <header class="page-head">
      <h1>{s.categories.title}</h1>
      <p class="lead">{s.categories.lead}</p>
    </header>
    <div class="tiles section section--tight">
      {getCategories().map((c, i) => (
        <a class="tile" href={href(locale, `/categories/${c.slug}/`)}>
          <span class="media"><img class={artClass(c.image, c.slug)} src={c.image} alt="" width="800" height="1000" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" /></span>
          <span class="tile__name">{c.name[locale]}<span aria-hidden="true">{locale === 'ar' ? '←' : '→'}</span></span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
