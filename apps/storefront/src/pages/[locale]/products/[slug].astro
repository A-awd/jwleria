---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductArticle from '../../../components/ProductArticle.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { getBrand, getCategory, getProductModel, getRelatedProducts } from '../../../server/catalog';
import { href, isLocale, t } from '../../../i18n/ui';
import { productTitle } from '../../../components/view';
import { shareImage } from '../../../components/product-media.mjs';

const { locale, slug } = Astro.params;
if (!isLocale(locale)) return Astro.redirect('/404/');
// One read returns the model with the addressed variant selected; any variant URL stays valid.
const model = await getProductModel(slug ?? '');
if (!model) return Astro.redirect('/404/');
const product = model.selected;
const grouped = model.variants.length > 1;
const s = t(locale);
const [brand, related] = await Promise.all([getBrand(product.brandSlug), getRelatedProducts(product, 4, model.key)]);
const category = getCategory(product.categorySlug);
---
<BaseLayout locale={locale} title={productTitle(model, locale)} description={product.summary[locale]} path={`/products/${product.slug}/`} canonicalPath={`/products/${model.primary.slug}/`} image={shareImage(product)}>
  <div class="wrap">
    <nav class="crumb crumb--product">
      <a href={href(locale, '/catalog/')}>{s.nav.catalog}</a>
      {category && <> / <a href={href(locale, `/categories/${category.slug}/`)}>{category.name[locale]}</a></>}
    </nav>

    <ProductArticle model={model} locale={locale} brand={brand} origin={Astro.url.origin} />
    {grouped && <p class="variant-status" role="status" aria-live="polite" data-variant-status data-template={s.variants.showing('{ref}')}></p>}

    {related.length > 0 && (
      <section class="section" aria-labelledby="h-related">
        <div class="section-head"><h2 id="h-related">{s.product.related}</h2></div>
        <div class="grid grid--4">{related.map((p) => <ProductCard product={p} locale={locale} />)}</div>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  import { fragmentPath, variantPath, variantSwapper } from '../../../components/variant-swap.mjs';

  // Progressive enhancement (decision 0019): every choice is a real variant page, so it works without JavaScript.
  // With JavaScript:
  // - a choice shows at once, and the gallery never keeps another variant's photograph as this one;
  // - only that variant's product block is fetched, cached and prefetched on intent, and updated in place;
  // - the latest choice wins.
  // No touch, wheel or scroll listener is added, so native scrolling is never intercepted.
  type Choice = { link?: HTMLAnchorElement; kind?: string; key?: string; also?: string; ref?: string; photo?: string; keyboard?: boolean; history?: boolean };
  type State = { key: string; value: string; lang: string; label: string };
  const block = () => document.querySelector<HTMLElement>('[data-variant-root]');
  const pathOf = (link: HTMLAnchorElement) => new URL(link.href).pathname;
  const imageKey = (img: HTMLImageElement) => img.getAttribute('srcset') || img.getAttribute('src') || '';
  const states = (root: ParentNode) => new Map([...root.querySelectorAll<HTMLElement>('[data-control]')].map((c): [string, State] =>
    [c.dataset.control ?? '', { key: c.dataset.currentKey ?? '', value: c.dataset.currentValue ?? '', lang: c.dataset.currentLang ?? '', label: c.dataset.label ?? '' }]));
  // One sentence per option that changed without being chosen, built from the page's own template.
  const sentence = (template: string, change: State) => {
    const [before, after = ''] = template.replace('{label}', change.label).split('{value}');
    const value = document.createElement('bdi');
    value.textContent = change.value;
    if (change.lang) { value.lang = change.lang; value.dir = 'ltr'; }
    return [before, value, after];
  };

  // At once: the chosen value is selected, the reference changes, and the gallery says what is coming.
  function pending(_path: string, choice: Choice) {
    const root = block();
    if (!root) return;
    root.setAttribute('aria-busy', 'true');
    const link = choice.link;
    if (link) {
      const control = link.closest<HTMLElement>('[data-control]');
      const picker = link.closest<HTMLDetailsElement>('details[data-picker]');
      control?.querySelectorAll('a[data-variant-link][aria-current]').forEach((a) => a.removeAttribute('aria-current'));
      if (picker) {
        picker.open = false;
        const name = link.querySelector('.picker__name') ?? link.closest('.picker__row')?.querySelector('.picker__name');
        const value = picker.querySelector('.picker__value');
        if (name && value) value.replaceChildren(...[...name.cloneNode(true).childNodes]);
      } else link.setAttribute('aria-current', 'true');
      control?.setAttribute('data-pending', '');
    }
    if (choice.ref) {
      const reference = root.querySelector('[data-variant-reference]');
      if (reference) reference.textContent = choice.ref;
      const gallery = root.querySelector<HTMLElement>('.pdp__gallery');
      const status = gallery?.querySelector<HTMLElement>('[data-gallery-status]');
      if (gallery && status) {
        status.textContent = ((choice.photo === '1' ? root.dataset.photoLoading : root.dataset.photoMissing) ?? '').replace('{ref}', choice.ref);
        status.hidden = false;
        gallery.setAttribute('data-pending', '');
      }
    }
  }

  // Before showing: parse the block and decode its first new photograph, so it appears whole rather than flashing.
  async function prepare(html: string) {
    const next = new DOMParser().parseFromString(html, 'text/html').querySelector<HTMLElement>('[data-variant-root]');
    if (!next?.dataset.reference) throw new Error('Variant block missing');
    const loaded = new Set([...(block()?.querySelectorAll<HTMLImageElement>('.pdp__gallery img') ?? [])].map(imageKey));
    const first = next.querySelector<HTMLImageElement>('.pdp__gallery img');
    if (first && !loaded.has(imageKey(first))) {
      const probe = new Image();
      probe.sizes = first.getAttribute('sizes') ?? '';
      probe.srcset = first.getAttribute('srcset') ?? '';
      probe.src = first.getAttribute('src') ?? '';
      await Promise.race([probe.decode().catch(() => undefined), new Promise((done) => setTimeout(done, 1500))]);
    }
    return next;
  }

  function show(next: HTMLElement, path: string, choice: Choice) {
    const root = block();
    if (!root) return location.assign(path);
    const before = states(root);
    // The control that was used stays where it was on screen, whatever changed above it.
    const anchorAt = choice.kind ? `[data-control="${CSS.escape(choice.kind)}"]` : '.pdp__info';
    const top = root.querySelector(anchorAt)?.getBoundingClientRect().top;
    const fresh = document.adoptNode(next);
    // Sections the reader opened or closed stay as they were.
    const folds = new Map([...root.querySelectorAll<HTMLDetailsElement>('details[data-fold]')].map((d): [string, boolean] => [d.dataset.fold ?? '', d.open]));
    fresh.querySelectorAll<HTMLDetailsElement>('details[data-fold]').forEach((d) => { const open = folds.get(d.dataset.fold ?? ''); if (open !== undefined) d.open = open; });
    // An identical photograph moves over already decoded instead of loading again.
    const shown = new Map([...root.querySelectorAll<HTMLImageElement>('.pdp__gallery img')].map((img): [string, HTMLImageElement] => [imageKey(img), img]));
    fresh.querySelectorAll<HTMLImageElement>('.pdp__gallery img').forEach((img) => {
      const same = shown.get(imageKey(img));
      if (same) { same.className = img.className; same.alt = img.alt; img.replaceWith(same); }
    });
    root.replaceWith(fresh);
    document.title = fresh.dataset.title ?? document.title;
    const target = variantPath(path);
    if (target) document.querySelectorAll<HTMLAnchorElement>('a[hreflang]').forEach((a) => {
      const other = variantPath(new URL(a.href).pathname);
      if (other) a.setAttribute('href', `/${other.locale}/products/${target.slug}/`);
    });
    const moved = fresh.querySelector(anchorAt)?.getBoundingClientRect().top;
    if (top !== undefined && moved !== undefined && Math.abs(moved - top) > 1) window.scrollBy(0, moved - top);
    // Focus returns to the control that was used, never scrolling the page; a keyboard user keeps it in view.
    const control = choice.kind ? fresh.querySelector<HTMLElement>(`[data-control="${CSS.escape(choice.kind)}"]`) : null;
    const focus = (choice.link?.closest('[data-picker]') ? control?.querySelector<HTMLElement>('summary') : null)
      ?? control?.querySelector<HTMLElement>(`a[data-option-key="${CSS.escape(choice.key ?? '')}"]`)
      ?? control?.querySelector<HTMLElement>('summary');
    if (choice.link) focus?.focus({ preventScroll: true });
    const box = choice.keyboard ? focus?.getBoundingClientRect() : undefined;
    if (focus && box && (box.top < 0 || box.bottom > innerHeight)) focus.scrollIntoView({ block: 'nearest' });
    // The chosen variant's photograph and the control that was used belong on one screen (decision 0020): when the
    // photograph is above the screen and both fit, one short scroll brings it back instead of leaving it out of view.
    const header = document.querySelector('.site-header')?.getBoundingClientRect().bottom ?? 0;
    const picture = fresh.querySelector('.pdp__gallery')?.getBoundingClientRect();
    const used = (focus ?? fresh.querySelector(anchorAt))?.getBoundingClientRect();
    if (choice.link && picture && used && picture.top < header && used.bottom - picture.top + 16 <= innerHeight - header) {
      window.scrollBy({ top: picture.top - header - 8, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    }
    // One notice, only when the chosen variant also changed an option that was not chosen.
    const named = new Set([choice.kind, ...(choice.also ?? '').split(' ')].filter(Boolean));
    const changed = choice.link ? [...states(fresh)].filter(([k, c]) => !named.has(k) && before.has(k) && before.get(k)?.key !== c.key).map(([, c]) => c) : [];
    const template = fresh.querySelector<HTMLElement>('[data-config]')?.dataset.changed ?? '';
    const notice = fresh.querySelector<HTMLElement>('[data-config-notice]');
    if (notice && template && changed.length) {
      notice.replaceChildren(...changed.flatMap((c, i) => [...(i ? [' '] : []), ...sentence(template, c)]));
      notice.hidden = false;
    }
    const status = document.querySelector<HTMLElement>('[data-variant-status]');
    if (status) status.textContent = [(status.dataset.template ?? '').replace('{ref}', fresh.dataset.reference ?? ''), notice?.hidden === false ? notice.textContent : ''].join(' ').trim();
  }

  const swapper = variantSwapper<HTMLElement>({
    load: async (path) => {
      const response = await fetch(fragmentPath(path), { headers: { Accept: 'text/html' } });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      return response.text();
    },
    prepare,
    show,
    pending,
    fail: (path) => location.assign(path),
    // One entry per shown choice: Back returns to the variant chosen before, Forward to the one after.
    history: { push: (path) => window.history.pushState({ variant: variantPath(path)?.slug }, '', path) },
  });
  // The block this page opened on is kept, so Back to it is instant.
  const opened = block();
  if (opened) swapper.seed(location.pathname, opened.outerHTML);

  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-variant-link]');
    if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    // Choosing the value already shown only closes its list.
    if (link.getAttribute('aria-current') === 'true') { link.closest<HTMLDetailsElement>('details[data-picker]')?.removeAttribute('open'); return; }
    const { optionKind: kind, optionKey: key, also, ref, photo } = link.dataset;
    void swapper.choose(pathOf(link), { link, kind, key, also, ref, photo, keyboard: event.detail === 0 });
  });

  // Intent prefetch: the variant a finger lands on, or a keyboard focuses, starts loading before the click.
  const intent = (event: Event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-variant-link]');
    if (link && link.getAttribute('aria-current') !== 'true') swapper.prefetch(pathOf(link));
  };
  document.addEventListener('pointerdown', intent, { passive: true });
  document.addEventListener('focusin', intent);
  // When idle, and unless data saving is on: the first control's other values (at most four), the likeliest choices.
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const idle = (task: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(task, { timeout: 4000 }) : setTimeout(task, 2000));
  if (!connection?.saveData) idle(() => [...document.querySelectorAll<HTMLAnchorElement>('[data-variant-root] .config__control:first-child .segments a[data-variant-link]:not([aria-current])')].slice(0, 4).forEach((a) => swapper.prefetch(pathOf(a))));

  // Back and forward: the variant of the restored address is shown.
  window.addEventListener('popstate', () => {
    const shown = block()?.dataset.slug, target = variantPath(location.pathname);
    if (target && shown && target.slug !== shown) void swapper.choose(location.pathname, { history: true });
  });

  // Escape closes an open list and returns focus to its summary.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = (event.target as Element | null)?.closest<HTMLDetailsElement>('details[data-picker][open]');
    if (!open) return;
    open.open = false;
    open.querySelector<HTMLElement>('summary')?.focus();
  });
</script>
