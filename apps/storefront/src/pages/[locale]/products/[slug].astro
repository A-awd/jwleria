---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ProductGallery from '../../../components/ProductGallery.astro';
import VariantSelector from '../../../components/VariantSelector.astro';
import VariantText from '../../../components/VariantText.astro';
import { getBrand, getCategory, getProductModel, getRelatedProducts } from '../../../server/catalog';
import { href, isLocale, t } from '../../../i18n/ui';
import { productInquiry } from '../../../components/view';

const { locale, slug } = Astro.params;
if (!isLocale(locale)) return Astro.redirect('/404/');
// One read returns the model with the addressed variant selected; any variant URL stays valid.
const model = await getProductModel(slug ?? '');
if (!model) return Astro.redirect('/404/');
const product = model.selected;
const grouped = model.variants.length > 1;
const s = t(locale);
const [brand, related] = await Promise.all([getBrand(product.brandSlug), getRelatedProducts(product, 4, model.key)]);
const category = getCategory(product.categorySlug);
const inquiry = productInquiry(locale, product, Astro.url.origin, brand);
---
<BaseLayout locale={locale} title={grouped ? `${model.name[locale]} — ${product.reference}` : model.name[locale]} description={product.summary[locale]} path={`/products/${product.slug}/`} canonicalPath={`/products/${model.primary.slug}/`} image={product.image}>
  <div class="wrap">
    <nav class="crumb" style="padding-top:1.5rem">
      <a href={href(locale, '/catalog/')}>{s.nav.catalog}</a>
      {category && <> / <a href={href(locale, `/categories/${category.slug}/`)}>{category.name[locale]}</a></>}
    </nav>

    <article class:list={['pdp', { 'pdp--facts': !product.image }]} data-variant-root data-reference={product.reference}>
      <ProductGallery product={product} locale={locale} />

      <div class="pdp__info">
        {brand
          ? <a class="pdp__brand" href={href(locale, `/brands/${brand.slug}/`)} lang="en" dir="ltr">{brand.name}</a>
          : <p class="pdp__brand">{s.brands.ownTitle}</p>}
        <h1>{model.name[locale]}</h1>
        <p>{product.summary[locale]}</p>
        {product.isPreview && <p class="note">{s.preview} — {s.previewNote}</p>}
        {grouped && !product.image && <p class="note">{s.product.noPhoto}</p>}
        <VariantSelector variants={model.variants} selected={product} locale={locale} />
        <dl class="specs" data-variant-specs>
          <dt>{s.reference}</dt><dd><bdi data-variant-reference>{product.reference}</bdi></dd>
          {brand && product.collectionKind !== 'source-group' && <><dt>{s.product.collection}</dt><dd lang="en" dir="ltr" class="brand-name">{product.collection[locale]}</dd></>}
          {category && <><dt>{s.product.category}</dt><dd>{category.name[locale]}</dd></>}
          {product.specs.map((spec) => <><dt>{spec.label[locale]}</dt><dd><VariantText text={spec.value[locale]} lang={spec.valueLang} /></dd></>)}
        </dl>
        <section class="inquiry-note" id="inquiry" aria-labelledby="h-how">
          <h2 id="h-how">{s.product.how}</h2>
          <p>{product.isPreview ? s.dialog.explain : s.product.confirm}</p>
          <blockquote>{s.dialog.product(product.name[locale], product.reference, brand?.name)}</blockquote>
        </section>
      </div>

      <div class="pdp__cta">
        {inquiry ? <a class="cta cta--solid" href={inquiry.href} {...inquiry.attrs}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M4 19.5l1.3-3.9A8 8 0 1 1 8.4 18.7z" /></svg>
          {s.cta}
        </a> : <button class="cta cta--solid" type="button" disabled title={s.whatsapp.pendingDescription}>{s.cta} — {s.whatsapp.pending}</button>}
        {/* The variant links put other product URLs in this block, so a preview CTA carries its own label. */}
        <p class="note">{product.isPreview && `${s.preview} — `}{s.product.confirm}</p>
      </div>
    </article>
    {grouped && <p class="variant-status" role="status" aria-live="polite" data-variant-status data-template={s.variants.showing('{ref}')}></p>}

    {related.length > 0 && (
      <section class="section" aria-labelledby="h-related">
        <div class="section-head"><h2 id="h-related">{s.product.related}</h2></div>
        <div class="grid grid--4">{related.map((p) => <ProductCard product={p} locale={locale} />)}</div>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  // Progressive enhancement: the option links are real variant pages. With JavaScript the chosen
  // variant's server-rendered product block replaces this one in place; any failure navigates normally.
  let pending: AbortController | undefined;

  async function show(link: HTMLAnchorElement) {
    const root = document.querySelector<HTMLElement>('[data-variant-root]');
    if (!root) return location.assign(link.href);
    pending?.abort();
    const controller = (pending = new AbortController());
    const { optionKind: kind = '', optionKey: key = '' } = link.dataset;
    const url = new URL(link.href);
    root.setAttribute('aria-busy', 'true');
    try {
      const response = await fetch(url, { signal: controller.signal, headers: { Accept: 'text/html' } });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const next = new DOMParser().parseFromString(await response.text(), 'text/html');
      const block = next.querySelector<HTMLElement>('[data-variant-root]');
      if (!block?.dataset.reference) throw new Error('Variant block missing');
      if (controller !== pending) return;
      root.replaceWith(document.adoptNode(block));
      document.title = next.title;
      const languages = next.querySelectorAll<HTMLAnchorElement>('a[hreflang]');
      document.querySelectorAll<HTMLAnchorElement>('a[hreflang]').forEach((a, i) => { const h = languages[i]?.getAttribute('href'); if (h) a.setAttribute('href', h); });
      history.replaceState(history.state, '', url.pathname + url.search);
      block.querySelector<HTMLElement>(`[data-option-kind="${CSS.escape(kind)}"][data-option-key="${CSS.escape(key)}"]`)?.focus({ preventScroll: true });
      const status = document.querySelector<HTMLElement>('[data-variant-status]');
      if (status) status.textContent = (status.dataset.template ?? '').replace('{ref}', block.dataset.reference);
    } catch (error) {
      if ((error as Error).name !== 'AbortError') location.assign(url.href);
    }
  }

  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-variant-link]');
    if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    if (link.getAttribute('aria-current') !== 'true') void show(link);
  });
</script>
